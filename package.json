{
    "name": "specforge",
    "private": true,
    "type": "module",
    "scripts": {
        "cli": "bun src/cli.ts",
        "verify": "bun src/cli.ts verify",
        "compile": "bun build --compile src/cli.ts --outfile bin/specforge",
        "test": "bun test tests",
        "check": "bun --bun tsc --noEmit",
        "lint": "bun --bun oxlint --deny-warnings src tests bench .agents/skills/spec-behavior/evals",
        "fmt": "bun --bun dprint fmt",
        "fmt:check": "bun --bun dprint check",
        "bench": "bun bench/run.ts",
        "bench:compare": "bun bench/compare.ts"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "dprint": "0.65.0",
        "oxlint": "1.95.0",
        "tinybench": "6.2.5",
        "typescript": "7.0.2"
    },
    "packageManager": "bun@1.4.4"
}
