{
    "tasks": {
        "test": "deno test --allow-read=.agents/skills,docs",
        "fmt": "deno fmt --ignore=.agents/skills/spec-behavior-workspace",
        "lint": "deno lint",
        "check": "deno check src/**/*.ts tests/**/*.ts bench/**/*.ts",
        "cli": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys src/cli.ts",
        "verify": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys src/cli.ts verify",
        "compile": "deno compile --allow-read --allow-write --allow-env --allow-run --allow-sys --output bin/specforge src/cli.ts",
        "bench": "deno bench bench/",
        "bench:compare": "deno run --allow-read bench/compare.ts"
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 100,
        "semiColons": true
    },
    "lint": {
        "rules": {
            "tags": ["recommended"]
        }
    }
}
