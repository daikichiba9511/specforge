{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "jsPlugins": [{ "name": "docs", "specifier": "eslint-plugin-jsdoc" }],
    "rules": {
        "func-style": ["error", "declaration", { "overrides": { "namedExports": "declaration" } }],
        "prefer-arrow-callback": "error",
        "docs/require-jsdoc": ["error", { "enableFixer": false }],
        "docs/require-description": ["error", { "contexts": ["FunctionDeclaration"] }]
    }
}
